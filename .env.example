# Template for .env, which is gitignored and holds the real values.
# Every variable is optional except the database URL.
#
# The .env file should be mode 600. Nothing here is a secret; nothing in .env
# should be anything but.

# ---------------------------------------------------------------------------
# Database
#
# Point this at a READ-ONLY role. That role is the only boundary in this system
# that cannot be talked around — the SQL validator and the read-only
# transaction are defence in depth behind it, not substitutes for it.
# ---------------------------------------------------------------------------
SQLAGENT_DATABASE_URL="postgresql+psycopg://readonly_user:password@localhost:5432/yourdb"

# ---------------------------------------------------------------------------
# Models
#
# Two Bedrock Mantle routes, with different authentication:
#
#   /v1         + SQLAGENT_LLM_AUTH=sigv4          (signed with AWS credentials)
#   /openai/v1  + SQLAGENT_LLM_AUTH=bedrock_token  (short-lived bearer token,
#                                                   minted per process from the
#                                                   AWS credential chain)
#
# No static API key is stored anywhere. If a model returns 403 on one route,
# check the auth mode before concluding the model is unavailable.
# ---------------------------------------------------------------------------
SQLAGENT_LLM_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/openai/v1
SQLAGENT_LLM_AUTH=bedrock_token
SQLAGENT_LIGHT_MODEL=google.gemma-4-31b
SQLAGENT_STRONG_MODEL=google.gemma-4-31b

# Grades finished answers, offline, in the benchmark harness only. Best set to
# a different model family than the two above: a judge sharing the author's
# blind spot scores a bad answer well.
# SQLAGENT_JUDGE_MODEL=

# ---------------------------------------------------------------------------
# Domain notes the schema cannot carry: units, ambiguous terms, named metrics.
# Without this, a column storing paise is reported as rupees — a silent 100x.
# ---------------------------------------------------------------------------
SQLAGENT_GLOSSARY_PATH="glossaries/example.json"

# ---------------------------------------------------------------------------
# Quality toggles. All have defaults; these are the ones worth knowing about.
# ---------------------------------------------------------------------------
# SQLAGENT_AMBIGUITY_HANDLING=ask_human
# SQLAGENT_CONVERSATION_WINDOW=4
# SQLAGENT_SUMMARISE_CONVERSATION=true
# SQLAGENT_USE_CRITIC=false

# ---------------------------------------------------------------------------
# Tracing (Langfuse)
#
# Off unless both keys are set. One trace per question, one observation per
# step, a generation per model call; conversation threads become sessions.
# Result rows are never sent, and e-mail addresses / phone numbers are redacted
# before export. Keys: your Langfuse project -> Settings -> API Keys.
# The benchmark does not trace unless run with --trace.
# ---------------------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # EU; US: https://us.cloud.langfuse.com; or self-hosted
# LANGFUSE_TRACING_ENVIRONMENT=development
# SQLAGENT_TRACING_ENABLED=true
