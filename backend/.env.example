# --- database under analysis (read-only role) ---
APERTURE_DATABASE_URL="postgresql+psycopg://aperture_ro:aperture_ro_pw@localhost:5433/tiffinwala"

# Owner connection is intentionally unset: write statements are refused, not
# escalated, so Aperture never needs a credential that can modify data.
# APERTURE_OWNER_DATABASE_URL=

# --- bedrock ---
APERTURE_BEDROCK_MODEL_ID="qwen.qwen3-coder-next"
APERTURE_BEDROCK_REGION="us-east-1"
APERTURE_MAX_TOKENS=3000
APERTURE_TEMPERATURE=0.0

# --- guards ---
APERTURE_MAX_REPAIR_ATTEMPTS=2
APERTURE_MAX_EMPTY_RETRIES=1
APERTURE_ROW_LIMIT=1000
APERTURE_STATEMENT_TIMEOUT_MS=30000
APERTURE_MAX_ESTIMATED_COST=5000000
APERTURE_RUN_DEADLINE_SECONDS=120

# --- budget ledger (USD) ---
APERTURE_BUDGET_CEILING_USD=10.0
APERTURE_BUDGET_WARN_USD=5.0

# --- embeddings / vector index ---
APERTURE_EMBED_MODEL="sentence-transformers/all-mpnet-base-v2"
APERTURE_VECTOR_BACKEND=auto

# --- langsmith (optional; tracing disabled if key absent) ---
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=aperture
LANGSMITH_API_KEY=
